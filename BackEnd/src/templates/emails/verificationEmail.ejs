<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Verify your Dealio account</title>
	</head>
	<body style="margin: 0; padding: 0; background-color: #f4f7fb; font-family: Arial, Helvetica, sans-serif; color: #172033;">
		<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #f4f7fb;">
			<tr>
				<td align="center" style="padding: 40px 16px;">
					<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width: 560px; background-color: #ffffff; border: 1px solid #e3e9f2; border-radius: 12px;">
						<tr>
							<td style="padding: 32px 36px 24px; border-bottom: 1px solid #edf1f6;">
								<div style="font-size: 24px; font-weight: 700; letter-spacing: 0; color: #176b87;">Dealio</div>
							</td>
						</tr>
						<tr>
							<td style="padding: 36px;">
								<p style="margin: 0 0 12px; font-size: 14px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #176b87;">Email verification</p>
								<h1 style="margin: 0 0 16px; font-size: 28px; line-height: 1.25; color: #172033;">Welcome to Dealio</h1>
								<p style="margin: 0 0 28px; font-size: 16px; line-height: 1.6; color: #536176;">Use the verification code below to confirm your email address and finish creating your account.</p>
								<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
									<tr>
										<td align="center" style="padding: 22px; background-color: #eef8fb; border: 1px solid #cce9f0; border-radius: 8px;">
											<span style="font-size: 32px; font-weight: 700; letter-spacing: 8px; color: #176b87;"><%= email_verification_code %></span>
										</td>
									</tr>
								</table>
								<p style="margin: 20px 0 0; font-size: 14px; line-height: 1.6; color: #536176;">This code expires in <strong style="color: #172033;">10 minutes</strong>. If you did not create a Dealio account, you can safely ignore this email.</p>
							</td>
						</tr>
						<tr>
							<td style="padding: 20px 36px; background-color: #fafbfd; border-top: 1px solid #edf1f6;">
								<p style="margin: 0; font-size: 12px; line-height: 1.5; color: #8190a5;">&copy; <%= year %> Dealio Platform. All rights reserved.</p>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
